<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %> - Neon Blog</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <a href="/" class="logo">Neon Blog</a>
            <nav>
                <% if (user) { %>
                    <a href="/mypage">마이페이지</a>
                    <a href="/logout">로그아웃</a>
                <% } else { %>
                    <a href="/login">로그인</a>
                    <a href="/signup">회원가입</a>
                <% } %>
            </nav>
        </header>

        <article class="post-detail">
            <h1 style="color: var(--neon-blue); margin-bottom: 10px;"><%= post.title %></h1>
            <div class="post-meta" style="margin-bottom: 30px; border-bottom: 1px solid var(--border-color); padding-bottom: 15px;">
                <span>작성자: <span style="color: var(--neon-purple);"><%= post.username %></span></span>
                <span style="margin: 0 15px;">|</span>
                <span><%= new Date(post.created_at).toLocaleString() %></span>
            </div>
            
            <div style="font-size: 1.1rem; line-height: 1.8; margin-bottom: 40px; white-space: pre-wrap;"><%= post.content %></div>

            <div style="display: flex; align-items: center; gap: 15px;">
                <form action="/post/<%= post.id %>/like" method="POST">
                    <button type="submit" class="btn btn-outline" style="color: var(--neon-pink); border-color: var(--neon-pink);">
                        ❤ 좋아요 <%= likeCount %>
                    </button>
                </form>
                <a href="/" class="btn btn-outline">목록으로</a>
            </div>
        </article>

        <section class="comment-section">
            <h3 style="color: var(--neon-green); margin-bottom: 20px;">댓글 (<%= comments.length %>)</h3>
            
            <% if (user) { %>
                <form action="/post/<%= post.id %>/comment" method="POST" style="margin-bottom: 40px;">
                    <div class="form-group">
                        <textarea name="content" rows="3" placeholder="댓글을 입력하세요..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">댓글 작성</button>
                </form>
            <% } else { %>
                <p style="color: var(--text-secondary); margin-bottom: 30px;">
                    <a href="/login" style="color: var(--neon-blue);">로그인</a> 후에 댓글을 남길 수 있습니다.
                </p>
            <% } %>

            <div class="comments-list">
                <% comments.forEach(comment => { %>
                    <div class="comment">
                        <div class="post-meta" style="margin-bottom: 8px;">
                            <strong style="color: var(--neon-blue);"><%= comment.username %></strong>
                            <span style="margin-left: 10px; font-size: 0.8rem;"><%= new Date(comment.created_at).toLocaleString() %></span>
                        </div>
                        <div style="color: var(--text-primary);"><%= comment.content %></div>
                    </div>
                <% }) %>
            </div>
        </section>
    </div>
</body>
</html>
