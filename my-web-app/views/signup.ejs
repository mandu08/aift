<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>회원가입 - Neon Blog</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <a href="/" class="logo">Neon Blog</a>
            <nav>
                <a href="/login">로그인</a>
            </nav>
        </header>

        <div class="auth-form">
            <h1 style="text-align: center; color: var(--neon-purple); margin-bottom: 30px;">회원가입</h1>
            <form action="/signup" method="POST">
                <div class="form-group">
                    <label>사용자 아이디</label>
                    <input type="text" name="username" required placeholder="원하는 아이디를 입력하세요">
                </div>
                <div class="form-group">
                    <label>비밀번호</label>
                    <input type="password" name="password" required placeholder="비밀번호를 입력하세요">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px; padding: 12px; background-color: var(--neon-purple);">회원가입</button>
            </form>
            <p style="text-align: center; margin-top: 20px; font-size: 0.9rem; color: var(--text-secondary);">
                이미 계정이 있으신가요? <a href="/login" style="color: var(--neon-blue);">로그인</a>
            </p>
        </div>
    </div>
</body>
</html>
