<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>마이페이지 - Neon Blog</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <a href="/" class="logo">Neon Blog</a>
            <nav>
                <a href="/">홈으로</a>
                <a href="/logout">로그아웃</a>
            </nav>
        </header>

        <main>
            <h1 style="color: var(--neon-green); margin-bottom: 30px;"><%= user %>님의 활동</h1>
            
            <div style="margin-bottom: 40px;">
                <h2 style="font-size: 1.2rem; color: var(--text-secondary); margin-bottom: 20px; border-left: 4px solid var(--neon-green); padding-left: 15px;">내가 쓴 글</h2>
                
                <% if (posts.length === 0) { %>
                    <p style="color: var(--text-secondary);">아직 작성한 글이 없습니다. <a href="/write" style="color: var(--neon-blue);">첫 글을 작성해보세요!</a></p>
                <% } %>

                <% posts.forEach(post => { %>
                    <div class="post-card" style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <h3 style="margin: 0;"><a href="/post/<%= post.id %>" style="color: var(--text-primary); text-decoration: none;"><%= post.title %></a></h3>
                            <span class="post-meta"><%= new Date(post.created_at).toLocaleDateString() %></span>
                        </div>
                        <div style="display: flex; gap: 10px;">
                            <a href="/edit/<%= post.id %>" class="btn btn-outline" style="padding: 5px 12px; font-size: 0.85rem; border-color: var(--neon-purple); color: var(--neon-purple);">수정</a>
                            <form action="/post/<%= post.id %>/delete" method="POST" onsubmit="return confirm('정말 삭제하시겠습니까?')">
                                <button type="submit" class="btn btn-outline" style="padding: 5px 12px; font-size: 0.85rem; border-color: var(--neon-pink); color: var(--neon-pink);">삭제</button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            </div>

            <a href="/write" class="btn btn-primary" style="background-color: var(--neon-green);">새 글 작성하기</a>
        </main>
    </div>
</body>
</html>
